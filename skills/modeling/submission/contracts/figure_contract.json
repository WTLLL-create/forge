{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FigureArtifact",
  "description": "图片Artifact — 从文字引用升级为结构化图片+编号+题注",
  "type": "object",
  "required": ["id", "caption", "source", "purpose"],
  "properties": {
    "id": {"type": "string", "pattern": "^FIG_\\d+_\\d+$", "description": "如 FIG_5_1"},
    "caption": {"type": "string", "description": "图标题，如 '图5-1 动力学拟合曲线'"},
    "purpose": {"type": "string", "description": "该图服务的Claim，如 'prove_model_fit'"},
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["file", "generated", "placeholder"]},
        "path": {"type": "string", "description": "图片文件路径 (type=file)"},
        "generator": {"type": "string", "description": "生成脚本 (type=generated)"}
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "width_cm": {"type": "number", "default": 14},
        "alignment": {"type": "string", "enum": ["center"], "default": "center"},
        "dpi": {"type": "integer", "default": 300}
      }
    },
    "cross_references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "正文中引用该图的章节列表"
    },
    "explanation": {"type": "string", "description": "图的文字说明（观察+结论）"},
    "evidence_link": {"type": "string"},
    "score_dimension": {"type": "string", "enum": ["D1","D2","D3","D4","D5","D6"]}
  }
}
