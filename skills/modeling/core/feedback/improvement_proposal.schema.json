{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-v6/improvement-proposal/v1",
  "title": "ImprovementProposal — 系统改进建议",
  "description": "Failure Aggregator 生成的改进候选。必须人工审批后才能写入 experience_registry.yaml。系统不能自动修改自身行为。",
  "type": "object",
  "required": ["proposal_id", "target", "problem", "proposed_change", "evidence"],
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "格式: IP-YYYYMMDD-NNN"
    },
    "target": {
      "type": "object",
      "description": "改进目标 — 哪个模块/文件/规则",
      "properties": {
        "module": { "type": "string", "examples": ["ProblemIntelligence", "ContractValidator", "forge_runner"] },
        "file": { "type": "string", "examples": ["contract_validator.py", "problem_state.schema.json"] },
        "specific_rule": { "type": "string" }
      }
    },
    "problem": {
      "type": "string",
      "description": "当前存在的问题，用一句话描述"
    },
    "proposed_change": {
      "type": "string",
      "description": "建议的具体修改"
    },
    "expected_impact": {
      "type": "object",
      "properties": {
        "dimension": { "type": "string", "examples": ["D1", "D2", "D5"] },
        "estimated_score_gain": { "type": "integer" },
        "affected_cases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "description": "支持此改进的证据",
      "properties": {
        "failure_count": { "type": "integer" },
        "case_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 }
      }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" },
        "regression_risk": { "type": "boolean", "description": "是否会降低现有能力" }
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "deferred"] },
        "reviewer": { "type": "string" },
        "date": { "type": "string" },
        "comment": { "type": "string" }
      }
    }
  }
}
