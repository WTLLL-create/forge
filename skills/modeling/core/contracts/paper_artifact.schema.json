{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-v6/paper-artifact/v1",
  "title": "PaperArtifact — 论文产物统一合同 v1.0",
  "description": "定义 L6 Paper Pipeline 中所有编译器的统一输出接口。formula/table/chart/reference 编译器均产出此结构的对应子类型。被 paper_compiler 消费以组装最终论文。",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "source_skill", "content"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "唯一标识，格式: {type}-{section_id}-{index}"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["formula", "table", "chart", "reference"],
      "description": "产物类型"
    },
    "source_skill": {
      "type": "string",
      "description": "产出此 artifact 的技能 skill_id",
      "enum": ["formula_compiler", "table_compiler", "chart_compiler", "reference_compiler"]
    },
    "section_id": {
      "type": "string",
      "description": "artifact 所属的章节 ID（来自 PaperBlueprint）"
    },
    "content": {
      "type": "object",
      "description": "具体内容，按 artifact_type 选择对应子结构",
      "oneOf": [
        {"$ref": "#/$defs/formula_content"},
        {"$ref": "#/$defs/table_content"},
        {"$ref": "#/$defs/chart_content"},
        {"$ref": "#/$defs/reference_content"}
      ]
    },
    "insertion_point": {
      "type": "object",
      "properties": {
        "before_block": {"type": "string"},
        "after_block": {"type": "string"}
      },
      "description": "在 SectionArtifact 的哪个 content_block 之前/之后插入"
    },
    "rendering": {
      "type": "object",
      "properties": {
        "ready": {"type": "boolean", "description": "是否已经渲染为可插入 docx 的格式"},
        "format": {"type": "string", "enum": ["latex", "docx_xml", "png", "text"]}
      }
    }
  },
  "$defs": {
    "formula_content": {
      "type": "object",
      "required": ["formulas"],
      "properties": {
        "formulas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "latex"],
            "properties": {
              "id": {"type": "string", "description": "公式编号, 如 F-TOPSIS-1"},
              "latex": {"type": "string", "description": "LaTeX 源码"},
              "label": {"type": "string", "description": "公式名称, 如 '归一化公式'"},
              "variables": {"type": "array", "items": {"type": "string"}, "description": "公式中使用的变量"},
              "source_model": {"type": "string", "description": "来自哪个模型"}
            }
          }
        }
      }
    },
    "table_content": {
      "type": "object",
      "required": ["table_spec"],
      "properties": {
        "table_spec": {
          "type": "object",
          "required": ["headers", "rows"],
          "properties": {
            "headers": {"type": "array", "items": {"type": "string"}},
            "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
            "caption": {"type": "string", "description": "表标题, 如 '表1 三种核桃油各时间点品质评分'"},
            "style": {"type": "string", "enum": ["three_line", "plain"], "default": "three_line"},
            "source_data": {"type": "string", "description": "数据来源 (来自 ModelResult 的哪个字段)"}
          }
        }
      }
    },
    "chart_content": {
      "type": "object",
      "required": ["chart_spec"],
      "properties": {
        "chart_spec": {
          "type": "object",
          "required": ["chart_type", "data"],
          "properties": {
            "chart_type": {"type": "string", "enum": ["line", "bar", "scatter", "heatmap", "pareto", "comparison", "flowchart"]},
            "title": {"type": "string"},
            "data": {"type": "object", "description": "绘图数据, 结构化键值对"},
            "x_label": {"type": "string"},
            "y_label": {"type": "string"},
            "output_path": {"type": "string", "description": "渲染后的 PNG 路径"},
            "dpi": {"type": "integer", "default": 600}
          }
        }
      }
    },
    "reference_content": {
      "type": "object",
      "required": ["references"],
      "properties": {
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "description": "引用编号, 如 [1]"},
              "text": {"type": "string", "description": "GB/T 7714-2015 格式的完整引用文本"},
              "type": {"type": "string", "enum": ["journal", "book", "conference", "web", "thesis"]},
              "source_model": {"type": "string", "description": "引用此文献的模型/方法"}
            }
          }
        },
        "style": {"type": "string", "const": "GB/T 7714-2015"},
        "count": {"type": "integer", "minimum": 5}
      }
    }
  }
}
